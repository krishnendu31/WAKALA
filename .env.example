# WAKALA — example configuration. All values below are the built-in defaults,
# so nothing needs to be set. No secrets belong in any env file: development
# signing keys are generated into backend/.dev_keys/ (git-ignored).
#
# Backend: variables are read from the process environment (set them in the
# shell before starting the server). Frontend: put VITE_* values in
# frontend/.env.local, which Vite loads automatically.

# --- Backend (read by backend/app/core/config.py) ---
# "production" is refused: Phase 1 is a development prototype.
WAKALA_ENV=development
# SQLite file shared by the server and the dev CLI (git-ignored). ":memory:" is used by tests.
# WAKALA_DB_PATH=/absolute/path/to/backend/var/wakala.db   (default when unset)
# Developer demonstration endpoints (/api/dev/*). Off unless set; run_dev.py sets it to 1.
WAKALA_DEV_MODE=0
# Directory for DEVELOPMENT-ONLY Ed25519 private keys. Never commit it.
# WAKALA_DEV_KEYS_DIR=/absolute/path/to/backend/.dev_keys    (default when unset)
# Accepted clock skew for signed requests, in seconds (5-600).
WAKALA_MAX_REQUEST_SKEW_SECONDS=60
# Comma-separated. Only loopback origins are accepted; anything else refuses to start.
WAKALA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Frontend (read by Vite; must be prefixed VITE_) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
