{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wakala-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/run_dev.py"
      ],
      "port": 8000
    },
    {
      "name": "wakala-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}