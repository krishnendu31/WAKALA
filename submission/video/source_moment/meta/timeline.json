 "subtitles": [
  {
   "start": 0.8,
   "end": 4.655,
   "text": "Imagine government services where AI agents don't just respond."
  },
  {
   "start": 5.005,
   "end": 8.69,
   "text": "They act, collaborate, and complete tasks for citizens."
  },
  {
   "start": 11.2,
   "end": 15.714,
   "text": "But even a trusted agent can attempt an action it was never authorized to perform."
  },
  {
   "start": 20.05,
   "end": 24.064,
   "text": "WAKALA verifies who the agent is, what authority it was given,"
  },
  {
   "start": 24.064,
   "end": 27.042,
   "text": "and whether this specific action is permitted."
  },
  {
   "start": 27.65,
   "end": 32.141,
   "text": "If it exceeds that authority, WAKALA stops it, before execution."
  },
  {
   "start": 32.6,
   "end": 34.311,
   "text": "And this isn't just a concept."
  },
  {
   "start": 34.661,
   "end": 39.27,
   "text": "Our working prototype enforces that decision through a real authorization gateway."
  },
  {
   "start": 40.7,
   "end": 43.704,
   "text": "An authorized officer can contain the incident,"
  },
  {
   "start": 43.704,
   "end": 47.858,
   "text": "restore valid authority, and let the legitimate service continue."
  },
  {
   "start": 50.2,
   "end": 53.333,
   "text": "Security, without unnecessary disruption."
  },
  {
   "start": 55.45,
   "end": 59.912,
   "text": "WAKALA. Autonomous AI. Accountable actions."
  }
 ],
