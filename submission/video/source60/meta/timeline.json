 "subtitles": [
  {
   "start": 0.536,
   "end": 4.164,
   "text": "When government AI can act, who verifies its authority?"
  },
  {
   "start": 5.921,
   "end": 8.38,
   "text": "WAKALA verifies each agent's identity,"
  },
  {
   "start": 8.38,
   "end": 12.779,
   "text": "and limits every delegated action to the citizen's specific request."
  },
  {
   "start": 14.752,
   "end": 17.298,
   "text": "In a separate, deliberately triggered test,"
  },
  {
   "start": 17.298,
   "end": 20.496,
   "text": "the Insurance Agent asks for another citizen's record."
  },
  {
   "start": 20.746,
   "end": 23.948,
   "text": "WAKALA blocks it before any protected data is returned."
  },
  {
   "start": 25.8,
   "end": 30.779,
   "text": "Behaviour Watch raises an incident. A verified officer contains it,"
  },
  {
   "start": 30.779,
   "end": 33.9,
   "text": "and reassigns the task to a standby agent."
  },
  {
   "start": 35.89,
   "end": 40.247,
   "text": "The legitimate service continues, unrelated citizens are unaffected,"
  },
  {
   "start": 40.247,
   "end": 42.81,
   "text": "and every completed action is traceable."
  },
  {
   "start": 44.35,
   "end": 46.892,
   "text": "Attack Lab runs eight attack scenarios."
  },
  {
   "start": 46.892,
   "end": 50.608,
   "text": "Document Shield quarantines hidden document instructions."
  },
  {
   "start": 51.35,
   "end": 56.705,
   "text": "Synthetic benchmarks measure enforcement. Shadow Mode tests policies safely."
  }
 ]
